# =======================================================================
# Tooba Consultancy - Apache React Single-Page Application (SPA) Routing
# =======================================================================

# 1. Establish index.html as the primary directory index document
DirectoryIndex index.html

# 2. React Router & Client-Side SPA Sub-Route Fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If index.html is directly requested, serve it immediately without further rewriting
  RewriteRule ^index\.html$ - [L]

  # If the requested path corresponds to an existing file, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-f

  # If the requested path corresponds to an existing directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-d

  # If the requested path is a symbolic link, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-l

  # Route all other requests (including sub-routes) to index.html for client-side handling
  RewriteRule . /index.html [L]
</IfModule>

# 3. Static Assets Caching for High Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML files - revalidate immediately to deliver updates
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript and Web Fonts
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Images and Icons
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 4. Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/x-javascript image/svg+xml
</IfModule>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
